{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@errand/ui": ["frontend/packages/ui/src"],
      "@errand/types": ["frontend/packages/types/src"],
      "@errand/utils": ["frontend/packages/utils/src"],
      "@errand/api": ["frontend/packages/api/src"],
      "@errand/constants": ["frontend/packages/constants/src"]
    }
  },
  "exclude": ["node_modules"]
}
